{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_project"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "default_project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    }
  }
}
