{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "ts", "actor", "type", "data"],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^E-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    }
  }
}
